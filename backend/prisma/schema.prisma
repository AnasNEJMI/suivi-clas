// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  firstName    String   @default("john")
  lastName     String   @default("doe")
  passwordHash String

  //characteristics
  classId      Int?
  class        Class?    @relation(fields : [classId], references: [id], onDelete : SetNull)
  gender       UserGender @default(m) //gender is either 'm' | 'f'
  role         UserRole @default(student) //role is either 'admin' | 'org' | 'student'

  //additional info
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastVisit    DateTime @default(now()) //last time the user visited their profile page

  sessions Session[] //a user can have multiple sessions
  bilans Bilan[] //a user can have multiple bilans
  skill Skill? //a user can have at most one skill entry
  qcms Qcm[] // a user can have mutliple qcms

  @@index(classId)
}

model Class{
  id            Int      @id @default(autoincrement())
  label         String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users User[] //a class can have multiple users
  lessons Lesson[] //a class can have multiple lessons
}

model Bilan{
  id        Int       @id @default(autoincrement())

  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete : Cascade)

  presence  Boolean @default(false)
  subject   String? 

  lessonId  Int?
  lesson    Lesson?      @relation(fields: [lessonId], references: [id], onDelete : SetNull)

  date      DateTime 
  summary   String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

   @@index([userId])
   @@unique([userId, date])
}

model Skill{
  id            Int       @id @default(autoincrement())
  userId        Int       @unique
  user          User      @relation(fields: [userId], references: [id], onDelete : Cascade)
  ponctuality   Int       @default(0)
  preparation   Int       @default(0)
  autonomy      Int       @default(0)
  organisation  Int       @default(0)
  regularity    Int       @default(0)
  discipline    Int       @default(0)
  respect       Int       @default(0)

  positive      String    @default("")
  negative      String    @default("")
  improvements  String    @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Document{
  id           Int       @id @default(autoincrement())

  lessonId      Int
  lesson        Lesson    @relation(fields : [lessonId], references: [id], onDelete : Cascade)
  
  type         String @default("fiche") //type can be either 'fiche' | 'qcm' | 'exercices'
  link         String  @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  //@@unique([type, link])
}

model Lesson{
  id           Int       @id @default(autoincrement())

  classId      Int
  class        Class    @relation(fields : [classId], references: [id], onDelete : Cascade)
  
  subject      String @default("math")
  
  label        String @default("")
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  bilans Bilan[] // a lesson can have mutliple bilans
  documents Document[] // a lesson can have mutliple docs
  qcms Qcm[] // a lesson can have mutliple qcms
  qcmBankQuestions QcmBankQuestion[]
  @@index([subject])
  //@@unique([classId, subject, label])
}

model Session {
  id        String    @id @default(uuid())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete : Cascade)

  //session data
  createdAt DateTime  @default(now())
  expiresAt DateTime
  lastActiveAt DateTime @default(now())
  
  //security
  userAgent String?
  ipAddress String?

  @@index([userId])
  @@index([expiresAt])
}


//////QCM///////

model QcmBankQuestion{
  id                Int        @id @default(autoincrement())

  lessonId          Int
  lesson            Lesson     @relation(fields : [lessonId], references: [id], onDelete : Cascade)

  question          String     @default("")
  difficulty        Difficulty @default(e)
  answerA           String     @default("")
  answerB           String     @default("")
  answerC           String     @default("")
  answerD           String     @default("")
  correctAnswer     AnswerChoice
  explanation       String     @default("")

  createdAt         DateTime   @default(now())

  @@index([lessonId])
  qcmQuestions QcmQuestion[]
}

model Qcm{
  id               Int         @id @default(autoincrement())

  userId           Int
  user             User        @relation(fields: [userId], references: [id], onDelete : Cascade)

  lessonId         Int
  lesson           Lesson        @relation(fields : [lessonId], references: [id], onDelete : Cascade)

  completed        Boolean     @default(false)

  createdAt        DateTime    @default(now())

  @@index([userId])

  qcmQuestions QcmQuestion[]
}

model QcmQuestion{
  id               Int         @id @default(autoincrement())

  bankQuestionId   Int
  bankQuestion     QcmBankQuestion    @relation(fields: [bankQuestionId], references: [id], onDelete : Cascade)

  qcmId            Int
  qcm              Qcm         @relation(fields: [qcmId], references: [id], onDelete : Cascade)

  selectedChoice   AnswerChoice?
  correct          Boolean     @default(false)

  createdAt        DateTime    @default(now())

  @@index([bankQuestionId])
  @@index([qcmId])
}


////////////////////////////////////////////

enum UserRole {
  student
  admin
  org
}
enum UserGender {
  m
  f
}

enum Difficulty{
  e
  m
  h
}

enum AnswerChoice{
  a
  b
  c
  d
}