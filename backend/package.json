{
  "name": "ready",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "dev": "npm run prisma:generate && tsx --watch src/server.ts",
    "build": "npm run prisma:generate && tsc",
    "start": "node dist/server.js",
    "reseed-db": "npx prisma migrate reset && npx prisma migrate dev && npx prisma generate && npx prisma db seed && npm run seed-animator-submissions && npm run restore-qcm-bank-questions",
    "seed-animator-submissions": "tsx prisma/seed.animator-submissions.ts",
    "clear-animator-submissions": "tsx prisma/seed.animator-submissions.ts --clear",
    "seed-qcm-bank-questions": "tsx prisma/seed.qcm-questions.ts",
    "clear-qcm-bank-questions": "tsx prisma/seed.qcm-questions.ts --clear",
    "extract-qcm-bank-questions": "tsx prisma/extract-qcm-bank-questions.ts",
    "restore-qcm-bank-questions": "tsx prisma/restore-qcm-bank-questions.ts"
  },
  "keywords": [],
  "author": "AnasNEJMI",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.8",
    "@vitest/coverage-v8": "^4.0.17",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@google/generative-ai": "^0.24.1",
    "@mistralai/mistralai": "^2.6.3",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "groq-sdk": "^1.5.0",
    "helmet": "^8.1.0",
    "openai": "^7.4.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.5"
  }
